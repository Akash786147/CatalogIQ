# Copy to backend/.env and fill in. Never commit .env — it is gitignored.
#
# The pipeline runs headless with NO key at all: every LLM call site falls back
# to a deterministic path, which is the actual evaluation condition. Keys only
# add Stage 1 classification, template naming, and document extraction.

# ---- providers ----------------------------------------------------------
# Configure any subset. With "auto" they are tried in order — OpenRouter,
# then Groq, then Gemini — so a rate limit on one does not stop a run.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# "auto" | "openrouter" | "groq" | "gemini"
#
# MEASURED TRADEOFF on the 1,000-row sample (full CLI run):
#   openrouter (stealth/ox-alpha)   ~5m45s   51 rows classified, 164 unclassified
#   groq       (openai/gpt-oss-120b)  ~52s   40 rows classified, 176 unclassified
#
# OpenRouter classifies a little more, ~6x slower. Set this to "groq" when you
# want the UI to feel fast — for a live demo, that is usually the right call.
CATALOGIQ_LLM_PROVIDER=auto

# ---- models -------------------------------------------------------------
# Verified against each provider's /models listing. Gemini uses the "-latest"
# alias so a model deprecation does not 404 the pipeline.
CATALOGIQ_OPENROUTER_MODEL=stealth/ox-alpha
CATALOGIQ_GROQ_MODEL=openai/gpt-oss-120b
CATALOGIQ_GEMINI_MODEL=gemini-flash-latest

# ---- pipeline tuning ----------------------------------------------------
# Stage 1 caches classification per (distributor, description signature) and
# runs the unique groups concurrently. These bound a first run on an
# unfamiliar dataset.
CATALOGIQ_MAX_CLASSIFICATION_LLM_CALLS=60
CATALOGIQ_CLASSIFICATION_CONCURRENCY=8

# Cross-row consensus: agreeing siblings required before a value propagates.
CATALOGIQ_MIN_CONSENSUS_SIBLINGS=3

# Fuzzy vocabulary match: below this score (0-100), reject rather than snap.
CATALOGIQ_LOV_FUZZY_THRESHOLD=88
