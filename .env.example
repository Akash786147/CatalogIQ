# Copy to .env at the repo root and fill in. Never commit .env.

# Required for the classify / template-induction / retrieval stages.
# The pipeline runs without it, but those three stages no-op and everything
# falls back to deterministic paths.
ANTHROPIC_API_KEY=

# Model used at all three LLM call sites.
CATALOGIQ_MODEL=claude-sonnet-5

# Paths (relative to repo root)
CATALOGIQ_DATA_DIR=data
CATALOGIQ_OUTPUT_DIR=data/output
CATALOGIQ_DB_PATH=data/catalogiq.sqlite

# Pipeline behaviour
CATALOGIQ_MAX_CONCURRENCY=8
CATALOGIQ_CONFIDENCE_THRESHOLD=0.85   # below this, a cell goes to the review queue
CATALOGIQ_LLM_ENABLED=true            # false => deterministic-only run, no API calls

# API
CATALOGIQ_API_PORT=8000
